# ── Python ───────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# ── Virtual environments ─────────────────────────────────
.venv/
venv/
env/

# ── Secrets & per-machine config ─────────────────────────
.env
# real config is per-machine; commit config.example.yaml only.
# NB: git has no inline comments — a trailing "# ..." becomes part of the
# pattern and the rule silently matches nothing.
config.yaml

# ── Runtime state ────────────────────────────────────────
memory/
data/
*.db
*.sqlite3
# Phase 6 vector store
.chroma/

# `lag study` progress and flashcard decks — per-machine, like memory/
study/

# ── OS ───────────────────────────────────────────────────
.DS_Store
._*
Thumbs.db
Desktop.ini

# ── IDE / editor ─────────────────────────────────────────
.vscode/
.idea/
.cursor/
*.swp
*.swo

# ── Test artifacts ───────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── Claude Code ──────────────────────────────────────────
.claude/settings.local.json

# Saved agent DEFINITIONS (agents/*.yaml) are tracked on purpose — they are the
# set-ups you build and keep. Only what a run leaves behind is per-machine.
agents/*.state.json
agents/*.stop
agents/.run.lock
# The goal pipeline's queue and its atomic-write temp file
agents/goals.json
agents/goals.json.tmp
agent/

# Agent sandbox workspaces: scratch space, per-machine
agents/workspaces/

# jsdom for the console boot test: installed on demand, never committed
tests/js/node_modules/
tests/js/package-lock.json

# ── Per-machine cruft, never committed ───────────────────
# Any node_modules anywhere (covers a stray npm install like src/lag/)
node_modules/
src/lag/package.json
src/lag/package-lock.json
# Recovery archive and a local price log that were tracked by mistake
files.zip
price.log
